# name: test/sql/external_secrets.test
# description: test external_secrets extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT external_secrets('Sam');
----
Catalog Error: Scalar Function with name external_secrets does not exist!

# Require statement will ensure this test is run with this extension loaded
require external_secrets

# Confirm the extension works
query I
SELECT external_secrets('Sam');
----
...........🦆 Sam

query I
SELECT external_secrets_openssl_version('Michael') ILIKE 'ExternalSecrets Michael, my linked OpenSSL version is OpenSSL%';
----
true
