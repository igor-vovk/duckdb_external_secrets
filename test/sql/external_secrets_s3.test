# name: test/sql/external_secrets_s3.test
# description: test external_secrets env provider with s3 secrets
# group: [sql, secrets]

require-env DUCKDB_SECRET_S3_ENV_SECRET

require external_secrets

statement ok
INSTALL httpfs;

statement ok
LOAD httpfs;

# Default env var lookup should still come from the secret name when no override is provided.
statement error
CREATE SECRET missing_secret (TYPE s3, PROVIDER env);
----
Invalid Input Error: Environment variable 'DUCKDB_SECRET_missing_secret' was not found for secret 'missing_secret'

# Explicit ENV_VAR should decouple the secret name from the environment variable name.
statement ok
CREATE SECRET bucket_access_secret (TYPE s3, PROVIDER env, ENV_VAR 'DUCKDB_SECRET_S3_ENV_SECRET', SCOPE 's3://bucket/')

# Implicit lookup should also work when the secret name matches the env var suffix.
statement ok
CREATE SECRET s3_env_secret (TYPE s3, PROVIDER env, SCOPE 's3://implicit-bucket/')

# The explicit ENV_VAR secret should be registered with the expected type/provider.
query TT
SELECT type, provider FROM duckdb_secrets() WHERE name = 'bucket_access_secret';
----
s3	env

# Scoped lookup should resolve to the explicitly configured secret.
query I
SELECT name FROM which_secret('s3://bucket/path/file.parquet', 's3');
----
bucket_access_secret

# The explicit ENV_VAR payload should be decoded into the stored secret values.
query I
SELECT sum(#1 IN ('key_id=abc123', 'secret=shhh')) FROM (
    SELECT unnest(secret_string.split(';'))
    FROM duckdb_secrets()
    WHERE name = 'bucket_access_secret'
);
----
2

# Scoped lookup should also resolve the implicitly named secret.
query I
SELECT name FROM which_secret('s3://implicit-bucket/path/file.parquet', 's3');
----
s3_env_secret

# The implicit name-based payload should decode identically.
query I
SELECT sum(#1 IN ('key_id=abc123', 'secret=shhh')) FROM (
    SELECT unnest(secret_string.split(';'))
    FROM duckdb_secrets()
    WHERE name = 's3_env_secret'
);
----
2
