# name: test/sql/external_secrets_postgres.test
# description: test external_secrets env provider with postgres secrets
# group: [sql, secrets]

require-env DUCKDB_SECRET_POSTGRES_ENV_SECRET

require external_secrets

statement ok
INSTALL postgres;

statement ok
LOAD postgres;

# Explicit ENV_VAR should work for postgres secrets after loading the postgres extension.
statement ok
CREATE SECRET reporting_db_secret (TYPE postgres, PROVIDER env, ENV_VAR 'DUCKDB_SECRET_POSTGRES_ENV_SECRET', SCOPE 'postgres://localhost/')

# Implicit env var lookup should still work when the postgres secret name matches the env var suffix.
statement ok
CREATE SECRET postgres_env_secret (TYPE postgres, PROVIDER env, SCOPE 'postgres://implicit-host/')

# The explicit ENV_VAR secret should resolve for its configured postgres scope.
query I
SELECT name FROM which_secret('postgres://localhost/sample_db', 'postgres');
----
reporting_db_secret

# The explicit ENV_VAR payload should be decoded into the stored postgres secret values.
query I
SELECT sum(#1 IN ('database=sample_db', 'host=localhost', 'password=topsecret', 'port=5432', 'user=duckdb')) FROM (
    SELECT unnest(secret_string.split(';'))
    FROM duckdb_secrets()
    WHERE name = 'reporting_db_secret'
);
----
5

# The implicit name-based postgres secret should resolve for its own scope.
query I
SELECT name FROM which_secret('postgres://implicit-host/sample_db', 'postgres');
----
postgres_env_secret

# The implicit name-based payload should decode identically for postgres.
query I
SELECT sum(#1 IN ('database=sample_db', 'host=localhost', 'password=topsecret', 'port=5432', 'user=duckdb')) FROM (
    SELECT unnest(secret_string.split(';'))
    FROM duckdb_secrets()
    WHERE name = 'postgres_env_secret'
);
----
5
